---
/**
 * Inline SVG icon set. Hand-rolled to keep the site dependency-free:
 * no icon package, no runtime JS, no font download.
 */
export type IconName =
  | "integral"
  | "search"
  | "sun"
  | "moon"
  | "menu"
  | "close"
  | "rss"
  | "arrow-right"
  | "arrow-left"
  | "clock"
  | "tag"
  | "book"
  | "lightbulb"
  | "check";

interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
  /** Decorative by default; pass a label to expose it to screen readers. */
  label?: string;
}

const { name, size = "1em", class: className, label } = Astro.props;
const dim = typeof size === "number" ? `${size}px` : size;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={dim}
  height={dim}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={label ? "img" : undefined}
  aria-hidden={label ? undefined : "true"}
  aria-label={label}
>
  {
    name === "integral" && (
      <>
        <path d="M17.5 3.5c-2.6-.9-4.3.6-4.8 3.4L9.6 17c-.5 2.8-2.2 4.3-4.8 3.4" />
        <path d="M7 11.5h10" opacity="0.001" />
      </>
    )
  }
  {
    name === "search" && (
      <>
        <circle cx="11" cy="11" r="6.5" />
        <path d="m16 16 4.5 4.5" />
      </>
    )
  }
  {
    name === "sun" && (
      <>
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </>
    )
  }
  {
    name === "moon" && <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" />
  }
  {
    name === "menu" && (
      <>
        <path d="M3.5 6.5h17M3.5 12h17M3.5 17.5h17" />
      </>
    )
  }
  {
    name === "close" && (
      <>
        <path d="M6 6l12 12M18 6L6 18" />
      </>
    )
  }
  {
    name === "rss" && (
      <>
        <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" />
        <circle cx="5.5" cy="18.5" r="1.5" fill="currentColor" stroke="none" />
      </>
    )
  }
  {name === "arrow-right" && <path d="M4 12h15m0 0-5.5-5.5M19 12l-5.5 5.5" />}
  {name === "arrow-left" && <path d="M20 12H5m0 0 5.5-5.5M5 12l5.5 5.5" />}
  {
    name === "clock" && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="M12 7.5V12l3 2" />
      </>
    )
  }
  {
    name === "tag" && (
      <>
        <path d="M3.5 12.5V5A1.5 1.5 0 0 1 5 3.5h7.5L20.5 11.5a1.5 1.5 0 0 1 0 2.1l-6.9 6.9a1.5 1.5 0 0 1-2.1 0L3.5 12.5Z" />
        <circle cx="8" cy="8" r="1.3" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === "book" && (
      <>
        <path d="M4 4.5A2 2 0 0 1 6 2.5h12a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H6a2 2 0 0 0-2 2Z" />
        <path d="M4 18.5a2 2 0 0 1 2-2h13" />
      </>
    )
  }
  {
    name === "lightbulb" && (
      <>
        <path d="M9 18h6M10 21h4" />
        <path d="M12 3a6 6 0 0 0-3.5 10.9V18h7v-4.1A6 6 0 0 0 12 3Z" />
      </>
    )
  }
  {name === "check" && <path d="m4.5 12.5 5 5 10-11" />}
</svg>
