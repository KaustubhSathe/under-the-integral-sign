---
import {
  TOPIC_LABELS,
  DIFFICULTY_LABELS,
  EXAM_LABELS,
  subtopicLabel,
  type Topic,
  type Difficulty,
  type ExamType,
} from "../lib/taxonomy";
import { href, titleize, cx } from "../lib/utils";

interface Props {
  kind?: "topic" | "subtopic" | "exam" | "difficulty" | "tag" | "status" | "theory" | "custom";
  /** Raw value, e.g. "integrals" or "hard". */
  value?: string;
  /** Override the visible label. */
  label?: string;
  /** Make it a link (default true for topic/subtopic/exam/tag). */
  as?: "link" | "span";
  /**
   * The entry's topic. Required for kind="subtopic" so the link can point at
   * /topic/<topic>/<subtopic>/.
   */
  topic?: string;
  class?: string;
  title?: string;
}

const { kind = "topic", value = "", label, as, topic, class: className, title } = Astro.props;

const text =
  label ??
  (kind === "topic"
    ? (TOPIC_LABELS[value as Topic] ?? titleize(value))
    : kind === "subtopic"
      ? subtopicLabel(value)
      : kind === "exam"
        ? (EXAM_LABELS[value as ExamType] ?? titleize(value))
        : kind === "difficulty"
          ? (DIFFICULTY_LABELS[value as Difficulty] ?? titleize(value))
          : kind === "theory"
            ? "Theory"
            : titleize(value));

const linkable =
  as === "link" ||
  (as === undefined &&
    (kind === "topic" || kind === "subtopic" || kind === "exam" || kind === "tag"));

const url =
  kind === "topic"
    ? `/topic/${value}/`
    : kind === "subtopic"
      ? topic
        ? `/topic/${topic}/${value}/`
        : undefined
      : kind === "exam"
        ? `/exam/${value}/`
        : kind === "tag"
          ? `/tags/${value}/`
          : undefined;

const classes = cx(
  "badge",
  kind === "topic" && "badge--topic",
  kind === "subtopic" && "badge--subtopic",
  kind === "exam" && "badge--exam",
  kind === "difficulty" && "badge--difficulty",
  kind === "status" && "badge--status",
  kind === "theory" && "badge--theory",
  className,
);
---

{
  linkable && url ? (
    <a class={classes} href={href(url)} title={title}>
      {text}
    </a>
  ) : (
    <span class={classes} title={title}>
      {text}
    </span>
  )
}
