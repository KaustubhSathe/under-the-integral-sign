---
import { TOPIC_LABELS, DIFFICULTY_LABELS, EXAM_LABELS, type Topic, type Difficulty, type ExamType } from "../lib/taxonomy";
import { href, titleize, cx } from "../lib/utils";

interface Props {
  kind?: "topic" | "exam" | "difficulty" | "tag" | "status" | "theory" | "custom";
  /** Raw value, e.g. "number-theory". */
  value?: string;
  /** Override the visible label. */
  label?: string;
  /** Make it a link (default true for topic/exam/tag). */
  as?: "link" | "span";
  class?: string;
  title?: string;
}

const { kind = "topic", value = "", label, as, class: className, title } = Astro.props;

const text =
  label ??
  (kind === "topic"
    ? (TOPIC_LABELS[value as Topic] ?? titleize(value))
    : kind === "exam"
      ? (EXAM_LABELS[value as ExamType] ?? titleize(value))
      : kind === "difficulty"
        ? (DIFFICULTY_LABELS[value as Difficulty] ?? titleize(value))
        : kind === "theory"
          ? "Theory"
          : titleize(value));

const linkable = as === "link" || (as === undefined && (kind === "topic" || kind === "exam" || kind === "tag"));
const url =
  kind === "topic"
    ? `/topic/${value}/`
    : kind === "exam"
      ? `/exam/${value}/`
      : kind === "tag"
        ? `/tags/${value}/`
        : undefined;

const classes = cx(
  "badge",
  kind === "topic" && "badge--topic",
  kind === "exam" && "badge--exam",
  kind === "difficulty" && "badge--difficulty",
  kind === "status" && "badge--status",
  kind === "theory" && "badge--theory",
  className,
);
---

{
  linkable && url ? (
    <a class={classes} href={href(url)} title={title}>
      {text}
    </a>
  ) : (
    <span class={classes} title={title}>
      {text}
    </span>
  )
}
