---
import Base from "../../layouts/Base.astro";
import EntryList from "../../components/EntryList.astro";
import { allEntries, stats } from "../../lib/entries";
import { TOPICS, TOPIC_LABELS, type Topic } from "../../lib/taxonomy";
import { pluralize } from "../../lib/utils";

export async function getStaticPaths() {
  const entries = await allEntries();
  const present = new Set(entries.flatMap((e) => e.topics));
  return TOPICS.filter((t) => present.has(t)).map((topic) => ({
    params: { topic },
    props: { topic },
  }));
}

interface Props {
  topic: Topic;
}

const { topic } = Astro.props;
const label = TOPIC_LABELS[topic];
const all = await allEntries();
const entries = all.filter((e) => e.topics.includes(topic));
const problems = entries.filter((e) => e.kind === "problems");
const theory = entries.filter((e) => e.kind === "theory");
const s = await stats();
---

<Base
  title={label}
  description={`${entries.length} entries on ${label} — problems and theory from JEE Advanced, RMO, INMO, IMO, Putnam and undergraduate mathematics.`}
  topics={s.topics}
  exams={s.exams}
>
  <div class="page-head">
    <p class="page-head__eyebrow">Topic</p>
    <h1 class="page-head__title">{label}</h1>
    <p class="page-head__lede">
      {pluralize(problems.length, "problem")} and {pluralize(theory.length, "theory note")}
      filed under {label}.
    </p>
  </div>

  {
    problems.length > 0 && (
      <section aria-labelledby="tp">
        <div class="section-head">
          <h2 id="tp">Problems</h2>
        </div>
        <EntryList entries={problems} showKeyIdea hideTopic showDate />
      </section>
    )
  }

  {
    theory.length > 0 && (
      <section aria-labelledby="tt">
        <div class="section-head">
          <h2 id="tt">Theory</h2>
        </div>
        <EntryList entries={theory} showKeyIdea hideTopic showDate />
      </section>
    )
  }
</Base>
