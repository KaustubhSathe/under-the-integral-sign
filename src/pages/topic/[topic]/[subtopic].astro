---
import Base from "../../../layouts/Base.astro";
import EntryList from "../../../components/EntryList.astro";
import { allEntries, stats } from "../../../lib/entries";
import { TOPICS, TOPIC_LABELS, subtopicLabel, subtopicsOf, type Topic } from "../../../lib/taxonomy";
import { count, href, pluralize } from "../../../lib/utils";

/** A subtopic page: /topic/calculus/integrals/ */
export async function getStaticPaths() {
  const entries = await allEntries();
  const present = new Set(entries.map((e) => `${e.topic}/${e.subtopic}`));
  return TOPICS.flatMap((topic) =>
    subtopicsOf(topic)
      .filter((sub) => present.has(`${topic}/${sub}`))
      .map((subtopic) => ({
        params: { topic, subtopic },
        props: { topic, subtopic },
      })),
  );
}

interface Props {
  topic: Topic;
  subtopic: string;
}

const { topic, subtopic } = Astro.props;
const topicLabel = TOPIC_LABELS[topic];
const subLabel = subtopicLabel(subtopic);

const all = await allEntries();
const entries = all.filter((e) => e.topic === topic && e.subtopic === subtopic);
const problems = entries.filter((e) => e.kind === "problems");
const theory = entries.filter((e) => e.kind === "theory");
const s = await stats();
---

<Base
  title={`${topicLabel} · ${subLabel}`}
  description={`${count(entries.length, "entry", "entries")} on ${subLabel} within ${topicLabel}.`}
  topics={s.topics}
  subtopics={s.subtopics}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <ol>
      <li><a href={href("/")}>Vault</a></li>
      <li><a href={href(`/topic/${topic}/`)}>{topicLabel}</a></li>
      <li aria-current="page">{subLabel}</li>
    </ol>
  </nav>

  <div class="page-head">
    <p class="page-head__eyebrow">{topicLabel}</p>
    <h1 class="page-head__title">{subLabel}</h1>
    <p class="page-head__lede">
      {pluralize(problems.length, "problem")} and {pluralize(theory.length, "theory note")}
      on {subLabel}.
    </p>
  </div>

  <EntryList
    entries={entries}
    showKeyIdea
    hideTopic
    showDate
    emptyMessage={`Nothing filed under ${subLabel} yet.`}
  />
</Base>
