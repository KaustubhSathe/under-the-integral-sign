---
import Base from "../../layouts/Base.astro";
import EntryList from "../../components/EntryList.astro";
import { allEntries, stats } from "../../lib/entries";
import { href, pluralize } from "../../lib/utils";
import { DIFFICULTIES, DIFFICULTY_LABELS, TOPICS, TOPIC_LABELS, type Difficulty, type Topic } from "../../lib/taxonomy";

const entries = (await allEntries()).filter((e) => e.kind === "problems");
const s = await stats();

const presentTopics = TOPICS.filter((t) => entries.some((e) => e.topics.includes(t)));
const presentDifficulties = DIFFICULTIES.filter((d) => entries.some((e) => e.difficulty === d));
---

<Base
  title="Problems"
  description={`${entries.length} competition and undergraduate problems from JEE Advanced, RMO, INMO, IMO, Putnam and integration bee, each with its key idea.`}
  topics={s.topics}
  exams={s.exams}
>
  <div class="page-head">
    <p class="page-head__eyebrow">Collection</p>
    <h1 class="page-head__title">Problems</h1>
    <p class="page-head__lede">
      {pluralize(entries.length, "problem")} across {pluralize(presentTopics.length, "topic")}.
      Every entry states the source, the key idea, and a complete solution.
    </p>
  </div>

  {
    entries.length > 0 && (
      <form class="filter-bar" id="problem-filter" role="search" aria-label="Filter problems">
        <label>
          Topic
          <select name="topic">
            <option value="">all</option>
            {presentTopics.map((t) => (
              <option value={t}>{TOPIC_LABELS[t as Topic]}</option>
            ))}
          </select>
        </label>
        <label>
          Difficulty
          <select name="difficulty">
            <option value="">any</option>
            {presentDifficulties.map((d) => (
              <option value={d}>{DIFFICULTY_LABELS[d as Difficulty]}</option>
            ))}
          </select>
        </label>
        <label>
          Search titles
          <input type="search" name="q" placeholder="cauchy, contour…" />
        </label>
        <button type="reset" class="header-link" style="font-family:inherit">Reset</button>
        <span class="filter-bar__count" id="filter-count">
          {pluralize(entries.length, "problem")}
        </span>
      </form>
    )
  }

  <EntryList entries={entries} showKeyIdea hideTopic={false} showDate emptyMessage="No problems yet." />

  <p class="faint" id="filter-empty" hidden style="margin-top:1rem">
    Nothing matches those filters.
  </p>
</Base>

<script>
  // Pure client-side filtering: the full list is already in the HTML, so this
  // works with no build step and degrades to "show everything" without JS.
  const form = document.getElementById("problem-filter") as HTMLFormElement | null;
  const list = document.querySelector<HTMLElement>(".card-grid");
  const count = document.getElementById("filter-count");
  const emptyNote = document.getElementById("filter-empty");
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".card"));

  function apply() {
    if (!form) return;
    const data = new FormData(form);
    const topic = String(data.get("topic") ?? "");
    const difficulty = String(data.get("difficulty") ?? "");
    const q = String(data.get("q") ?? "").trim().toLowerCase();

    let shown = 0;
    for (const card of cards) {
      const title = (card.querySelector(".card__title")?.textContent ?? "").toLowerCase();
      const cardTopics = card.dataset.topic ?? "";
      const okTopic = !topic || cardTopics === topic;
      const okDiff = !difficulty || card.dataset.difficulty === difficulty;
      const okQ = !q || title.includes(q);
      const visible = okTopic && okDiff && okQ;
      card.hidden = !visible;
      if (visible) shown++;
    }
    if (count) count.textContent = `${shown} problem${shown === 1 ? "" : "s"}`;
    if (emptyNote) emptyNote.hidden = shown !== 0;
    if (list) list.hidden = shown === 0;
  }

  form?.addEventListener("input", apply);
  form?.addEventListener("change", apply);
  form?.addEventListener("reset", () => setTimeout(apply, 0));

  // Deep links: /problems/?topic=algebra&difficulty=hard preselects the filters.
  const params = new URLSearchParams(location.search);
  if (form) {
    for (const key of ["topic", "difficulty", "q"]) {
      const value = params.get(key);
      const field = form.elements.namedItem(key);
      if (value && field instanceof HTMLInputElement) field.value = value;
      else if (value && field instanceof HTMLSelectElement) field.value = value;
    }
    if ([...params.keys()].length > 0) apply();
  }
</script>
