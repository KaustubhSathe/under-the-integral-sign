---
import { render, getCollection, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import EntryHeader from "../../components/EntryHeader.astro";
import EntryList from "../../components/EntryList.astro";
import Toc from "../../components/Toc.astro";
import { allEntries, relatedTo, stats, type EntryRef } from "../../lib/entries";

export async function getStaticPaths() {
  const theory = await getCollection("theory", (e) => !e.data.draft);
  return theory.map((entry) => ({
    // `entry.id` has no extension and keeps subdirectories:
    // "inequalities/jensen-inequality-concavity".
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"theory">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const pool = await allEntries();
const s = await stats();
// `entry.id` is content-relative ("inequalities/jensen-..."), i.e. EntryRef.path.
const found = pool.find((e) => e.kind === "theory" && e.path === entry.id);
const d = entry.data;
const self: EntryRef = found ?? {
  id: `theory/${entry.id}`,
  kind: "theory",
  slug: entry.id.slice(entry.id.lastIndexOf("/") + 1),
  path: entry.id,
  href: `/theory/${entry.id}/`,
  title: d.title,
  summary: d.summary,
  topic: d.topic,
  topics: [d.topic, ...(d.topics ?? []).filter((t) => t !== d.topic)],
  tags: d.tags ?? [],
  section: d.section,
  status: d.status,
  date: d.date,
  updated: d.updated,
  stars: 0,
};

const related = relatedTo(self, pool, 4, d.related ?? []).filter((e) => e.id !== self.id);
const description = d.summary || d.title;
---

<Base
  title={entry.data.title}
  description={description}
  type="article"
  topics={s.topics}
  exams={s.exams}
  published={entry.data.date}
  updated={entry.data.updated ?? entry.data.date}
>
  <article class="prose-with-toc">
    <div class="prose">
      <EntryHeader entry={self} data={entry.data as any} headings={headings} />

      {entry.data.statement && (
        <aside class="callout" style="margin-bottom:2rem">
          <p class="callout__title">Statement</p>
          <p style="margin:0">{entry.data.statement}</p>
        </aside>
      )}

      <Content />

      {
        entry.data.references && entry.data.references.length > 0 && (
          <section aria-labelledby="refs-head">
            <h2 id="refs-head">References</h2>
            <ul>
              {entry.data.references.map((r: { label: string; url?: string }) => (
                <li>
                  {r.url ? (
                    <a href={r.url} rel="noopener noreferrer">{r.label}</a>
                  ) : (
                    r.label
                  )}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        related.length > 0 && (
          <section aria-labelledby="related-head">
            <h2 id="related-head">Related in the vault</h2>
            <EntryList entries={related} showKeyIdea />
          </section>
        )
      }
    </div>

    <Toc headings={headings} />
  </article>
</Base>
