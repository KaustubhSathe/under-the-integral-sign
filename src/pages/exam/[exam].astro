---
import Base from "../../layouts/Base.astro";
import EntryList from "../../components/EntryList.astro";
import { allEntries, stats } from "../../lib/entries";
import { EXAM_TYPES, EXAM_LABELS, type ExamType } from "../../lib/taxonomy";
import { pluralize } from "../../lib/utils";

/**
 * Problems grouped by where they came from: /exam/putnam/
 *
 * Exam provenance is orthogonal to the topic → subtopic taxonomy — the same
 * integral can come from the integration bee or from JEE Advanced — so it gets
 * its own browsing axis rather than living inside the topic tree.
 */
export async function getStaticPaths() {
  const entries = await allEntries();
  const present = new Set(entries.map((e) => e.exam).filter(Boolean));
  return EXAM_TYPES.filter((e) => present.has(e)).map((exam) => ({
    params: { exam },
    props: { exam },
  }));
}

interface Props {
  exam: ExamType;
}

const { exam } = Astro.props;
const label = EXAM_LABELS[exam];
const all = await allEntries();
const entries = all.filter((e) => e.exam === exam).sort((a, b) => (b.year ?? 0) - (a.year ?? 0));
const s = await stats();

const years = [...new Set(entries.map((e) => e.year).filter(Boolean))] as number[];
---

<Base
  title={label}
  description={`${entries.length} problems from ${label}, with key ideas and complete solutions.`}
  topics={s.topics}
  subtopics={s.subtopics}
  exams={s.exams}
>
  <div class="page-head">
    <p class="page-head__eyebrow">Exam source</p>
    <h1 class="page-head__title">{label}</h1>
    <p class="page-head__lede">
      {pluralize(entries.length, "problem")} sourced from {label}
      {years.length > 1 && <>, spanning {Math.min(...years)}–{Math.max(...years)}</>}.
    </p>
  </div>

  <EntryList entries={entries} showKeyIdea hideTopic showDate />
</Base>
