# Copy this file to .env and set a real password.
#
# .env is git-ignored, so the password is never committed.
#
#   Copy-Item .env.example .env      (Windows PowerShell)
#   cp .env.example .env             (macOS / Linux)

# Required. The admin panel refuses to start without it.
ADMIN_PASSWORD=helloworld

# Optional overrides.
# ADMIN_PORT=4322
# ADMIN_HOST=127.0.0.1
# ADMIN_SESSION_HOURS=12
# ASTRO_PORT=4321
