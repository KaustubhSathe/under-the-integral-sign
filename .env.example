# Copy this file to .env and set a real password.
#
# .env is git-ignored, so the password is never committed.
#
#   Copy-Item .env.example .env      (Windows PowerShell)
#   cp .env.example .env             (macOS / Linux)

# Required. The admin panel refuses to start without it.
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Optional. Enables the "AI entry" option in the admin panel's New dialog:
# deepseek-flash drafts the frontmatter and body from a prompt, and can read the
# problem out of an attached photo.
#
# Get a key at https://platform.deepseek.com/. Without it the panel still works;
# the AI option just reports that it is unconfigured.
# The key is used only by the admin server and is never sent to the browser.
# DEEPSEEK_API_KEY=sk-...

# Optional overrides.
# ADMIN_PORT=4322
# ADMIN_HOST=127.0.0.1
# ADMIN_SESSION_HOURS=12
# ASTRO_PORT=4321

# DeepSeek model. Defaults to deepseek-flash, which is DeepSeek-V4.1-Flash and
# the only current model that accepts images. Point this elsewhere only if you
# know that model handles both text and vision.
# DEEPSEEK_MODEL=deepseek-flash

# The site's base path, matching `base` in astro.config.mjs. The admin panel
# needs it to build preview URLs the dev server actually serves: without it the
# "Rendered page" button and the preview pane open Astro's 404 page, which is
# returned with HTTP 200 and so looks like it worked.
#
# Only set this if you change `base`. Defaults to /under-the-integral-sign.
# Use "/" for a root domain or a user/organisation page.
# PUBLIC_BASE_PATH=/under-the-integral-sign
